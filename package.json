{
  "name": "collab-hub",
  "version": "3.0.0",
  "files": [
    "bin/",
    "extensions/",
    "public/",
    "src/",
    "server.json",
    "docs/UPSTREAM-REUSE.md",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "description": "Zero-dependency, local-first multi-agent Mission Control (53 MCP tools, Streamable HTTP /mcp, MCP Profiles, real-time cross-agent usage & cost engine, 14 mainstream AI coding clients) with Always-On Resident Cockpit & Dock (Antigravity, Claude Desktop, Codex Desktop), Interactive Command TUI v2 & Live StatusLine HUD, MCP Hub, Skills Sync, Worktree Merge Queue, Living Shared Rooms, Budgets, Triggers & Outbound Webhooks.",
  "type": "module",
  "exports": {
    ".": "./src/index.mjs",
    "./mcp": "./src/mcp-server.mjs",
    "./dashboard": "./src/dashboard.mjs"
  },
  "license": "MIT",
  "author": "Mortal",
  "repository": {
    "type": "git",
    "url": "https://github.com/mortal7520/collab-hub.git"
  },
  "keywords": [
    "ai-agents",
    "multi-agent",
    "mcp",
    "mcp-server",
    "mcp-apps",
    "claude-code",
    "codex",
    "cursor",
    "windsurf",
    "git-worktree",
    "terminal-ui",
    "local-first"
  ],
  "bin": {
    "collab-hub": "bin/collab-hub.mjs"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node src/dashboard.mjs",
    "setup": "node bin/collab-hub.mjs setup",
    "cockpit": "node bin/collab-hub.mjs cockpit --dock",
    "usage": "node bin/collab-hub.mjs usage",
    "mcp": "node src/mcp-server.mjs",
    "mail-proxy": "node src/mail-mcp-proxy.mjs",
    "cli": "node bin/collab-hub.mjs",
    "doctor": "node bin/collab-hub.mjs doctor",
    "test": "node --test test/*.test.mjs"
  }
}
