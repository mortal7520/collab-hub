{
  "manifest_version": 3,
  "name": "CollabHub — Chat-Box Live HUD & Smart Router",
  "short_name": "CollabHub HUD",
  "version": "3.0.0",
  "description": "Shadow DOM floating companion beside Claude, ChatGPT, Gemini, Muse, DeepSeek, Grok & Perplexity chat boxes: live cross-agent usage, smart routing & 1-click context insert.",
  "permissions": ["storage"],
  "host_permissions": [
    "http://127.0.0.1:5290/*",
    "http://localhost:5290/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "CollabHub Chat-Box Companion",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*",
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://gemini.google.com/*",
        "https://muse.ai/*",
        "https://chat.deepseek.com/*",
        "https://grok.com/*",
        "https://www.perplexity.ai/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
